{
  "name": "detective-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "better-sqlite3@13.0.3": false,
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/main.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/main.js",
    "test:e2e": "playwright test",
    "storage:runtime": "tsx scripts/ops/runtime-storage.ts",
    "probe": "tsx scripts/probes/readiness.ts",
    "probe:search": "tsx scripts/probes/search.ts",
    "probe:deepseek": "tsx scripts/probes/deepseek.ts",
    "probe:truth": "tsx scripts/probes/truth.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "8.3.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tencentcloud-sdk-nodejs-wsa": "4.1.329",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "9.2.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
