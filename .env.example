# Copy to .env for local foundation development. Choose two distinct private codes.
APP_ORIGIN=http://127.0.0.1:5173
PORT=3000
DATABASE_PATH=.local/detective.db
TRIAL_ACCESS_CODE=
DEMO_ACCESS_CODE=
# Explicit UTC timestamp, e.g. the actual planned end of this service.
SERVICE_ENDS_AT=
# Default remains offline. Opt in only after approving explicit finite money/call limits.
TRUTH_RUNTIME_ENABLED=0
# Historical limited-probe settings below are not required by the current unrestricted normal entry.
# Normal entry does not require LIVE_CAMPAIGN; see DEPLOYMENT.md for current startup configuration.
LIVE_CAMPAIGN_ENABLED=0
EXPERIENCE_RUNTIME_ENABLED=0
TTS_RUNTIME_ENABLED=0
# Explicit ids from the two reviewed basic voices; no clone or provider VoiceType input.
TTS_VOICE_IDS=zh-male-zhike,zh-female-zhifu
# Required when enabled: JSON with global/trial/demo BudgetAmounts objects (see runtime guide).
# This is NOT reset on restart; changes to persisted funding require an explicit migration.
RUNTIME_FUNDING_JSON=
# Choose exactly ONE search auth: YUANBAO_API_KEY or TENCENT_SECRET_ID + TENCENT_SECRET_KEY.
# If both exist (e.g. Bearer search plus TC3 speech), explicitly choose bearer or tc3.
SEARCH_AUTH_KIND=
YUANBAO_API_KEY=
DEEPSEEK_API_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TTS_REGION=
TENCENT_TTS_VOICE_ID=
